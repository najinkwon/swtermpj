<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="24dp"
        android:paddingBottom="112dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingRight="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="영수증 스캔"
                    android:textSize="31sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:letterSpacing="-0.03"
                    android:includeFontPadding="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="장본 내역을 재료 후보로 불러와요"
                    android:textSize="14sp"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="4dp"
                    android:includeFontPadding="true" />

            </LinearLayout>

            <TextView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="🧾"
                android:textSize="30sp"
                android:includeFontPadding="true" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="158dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_scan_hero_receipt"
            android:paddingLeft="22dp"
            android:paddingRight="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingRight="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="영수증 한 장이면 충분해요"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:letterSpacing="-0.02"
                    android:includeFontPadding="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="사진에서 재료 후보를 찾아 냉장고에 바로 추가할 수 있어요."
                    android:textSize="14sp"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:includeFontPadding="true" />

            </LinearLayout>

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:gravity="center"
                android:text="🛒"
                android:textSize="40sp"
                android:includeFontPadding="true" />

        </LinearLayout>

        <Button
            android:id="@+id/btnStartReceiptScan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="영수증 인식 시작"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginTop="18dp"
            android:includeFontPadding="true" />

        <Button
            android:id="@+id/btnReceiptResult"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="샘플 결과 확인"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/primary_green_dark"
            android:background="@drawable/bg_chip_white"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginTop="10dp"
            android:includeFontPadding="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_scan_tip"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="17dp"
            android:paddingBottom="17dp"
            android:layout_marginTop="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="인식 전 확인"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:includeFontPadding="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="영수증 전체가 보이게 촬영하면 더 정확해요. 인식된 재료는 저장 전에 이름과 수량을 수정할 수 있어요."
                android:textSize="14sp"
                android:textColor="@color/text_sub"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:includeFontPadding="true" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
