<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="재료 추가"
                    android:textColor="@color/text_main"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="직접 입력하거나 스캔으로 등록해요"
                    android:textColor="@color/text_sub"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <TextView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="➕"
                android:textSize="22sp"
                android:background="@drawable/bg_chip" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/bg_card"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="재료명"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/editIngredientName"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="예: 우유"
                android:background="@drawable/bg_chip_white"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_hint"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="자동 분류 카테고리"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textCategory"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:text="입력 후 자동 분류됩니다"
                android:textColor="@color/primary_green_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip"
                android:paddingLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="구매량"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/editInitialAmount"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="예: 500"
                android:inputType="number"
                android:background="@drawable/bg_chip_white"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_hint"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="현재 남은 양"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/editCurrentAmount"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="예: 100"
                android:inputType="numberDecimal"
                android:background="@drawable/bg_chip_white"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_hint"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="유통기한"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/editExpiryDate"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="예: 2026-06-30"
                android:inputType="date"
                android:background="@drawable/bg_chip_white"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_hint"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="22dp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="재료 저장하기"
                android:textSize="16sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_stat_mint"
            android:padding="18dp"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="빠른 등록"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/text_main" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="바코드나 영수증으로 더 빠르게 추가할 수 있어요"
                android:textSize="14sp"
                android:textColor="@color/text_sub"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnReceiptScan"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="영수증 스캔으로 추가"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnBarcodeScan"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="바코드로 상품 등록"
                android:textSize="15sp"
                android:layout_marginTop="10dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>