<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="바코드 인식"
                    android:textColor="@color/text_main"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="상품 바코드를 스캔해서 자동 등록해요"
                    android:textColor="@color/text_sub"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <TextView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="📷"
                android:textSize="24sp"
                android:background="@drawable/bg_chip" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_stat_mint"
            android:padding="24dp">

            <TextView
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:gravity="center"
                android:text="▣"
                android:textSize="48sp"
                android:textColor="@color/primary_green_dark"
                android:background="@drawable/bg_chip_white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="카메라로 바코드를 비춰주세요"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textSize="19sp"
                android:layout_marginTop="18dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="스캔이 완료되면 상품 정보 화면으로 자동 이동해요"
                android:textColor="@color/text_sub"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="3dp"
            android:padding="20dp"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="스캔 안내"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textSize="19sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• 바코드가 화면 중앙에 오도록 맞춰주세요\n• 어두운 곳에서는 인식이 느릴 수 있어요\n• 인식 후 식품안전나라 API로 상품 정보를 조회해요"
                android:textColor="@color/text_sub"
                android:textSize="14sp"
                android:lineSpacingExtra="6dp"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnStartBarcode"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="바코드 스캔 시작"
            android:textSize="16sp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
            android:layout_marginTop="22dp" />

        <Button
            android:id="@+id/btnBarcodeResult"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="샘플 바코드로 조회 확인"
            android:textSize="16sp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</ScrollView>
