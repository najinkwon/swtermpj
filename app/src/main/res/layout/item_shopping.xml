<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="18dp"
    android:elevation="3dp"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/textShoppingEmoji"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:gravity="center"
            android:text="🥬"
            android:textSize="28sp"
            android:background="@drawable/bg_chip" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginLeft="14dp">

            <TextView
                android:id="@+id/textShoppingName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="양파"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/text_main" />

            <TextView
                android:id="@+id/textShoppingPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="현재 재고 12%"
                android:textSize="14sp"
                android:textColor="@color/text_sub"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/textShoppingBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="부족"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="@color/accent_red"
            android:background="@drawable/bg_stat_red"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/textShoppingMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="재구매를 추천해요"
        android:textSize="15sp"
        android:textColor="@color/text_sub"
        android:lineSpacingExtra="4dp"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnShoppingSearch"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="쿠팡에서 검색"
        android:textSize="16sp"
        android:layout_marginTop="18dp" />

</LinearLayout>