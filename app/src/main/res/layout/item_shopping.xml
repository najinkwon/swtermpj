<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="106dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:paddingLeft="14dp"
    android:paddingRight="12dp"
    android:elevation="0dp"
    android:layout_marginBottom="9dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

    <TextView
        android:id="@+id/textShoppingEmoji"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="🥬"
        android:textSize="21sp"
        android:layout_marginRight="13dp"
        android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/textShoppingName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="양파"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_main"
            android:maxLines="2"
            android:ellipsize="end"
            android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/textShoppingPercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="레시피에 필요한 재료"
            android:textSize="12sp"
            android:textColor="@color/text_sub"
            android:layout_marginTop="6dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/textShoppingMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="구매하면 바로 만들 수 있어요"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/textShoppingBadge"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:gravity="center"
        android:text="부족"
        android:textStyle="bold"
        android:textSize="10sp"
        android:textColor="@color/accent_red"
        android:background="@drawable/bg_soft_red_chip"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

    <Button
        android:id="@+id/btnShoppingSearch"
        android:layout_width="70dp"
        android:layout_height="42dp"
        android:text="검색"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/bg_primary_button"
        android:backgroundTint="@null"
        android:gravity="center"
        android:includeFontPadding="true"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        
        android:stateListAnimator="@null" />

</LinearLayout>
