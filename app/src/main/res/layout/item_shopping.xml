<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="82dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:paddingLeft="14dp"
    android:paddingRight="12dp"
    android:elevation="2dp"
    android:layout_marginBottom="11dp">

    <TextView
        android:id="@+id/textShoppingEmoji"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="🥬"
        android:textSize="25sp"
        android:background="@drawable/bg_chip"
        android:layout_marginRight="13dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textShoppingName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="양파"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_main"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/textShoppingPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="현재 재고 12%"
            android:textSize="13sp"
            android:textColor="@color/text_sub"
            android:layout_marginTop="5dp" />

        <TextView
            android:id="@+id/textShoppingMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="재구매 추천"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/textShoppingBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="부족"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="@color/accent_red"
        android:background="@drawable/bg_stat_red"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginRight="8dp" />

    <Button
        android:id="@+id/btnShoppingSearch"
        android:layout_width="62dp"
        android:layout_height="38dp"
        android:text="구매"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/bg_primary_button"
        android:textColor="@color/white"
        android:paddingLeft="0dp"
        android:paddingRight="0dp" />

</LinearLayout>