<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="18dp"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card"
    android:elevation="3dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/textIngredientIcon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:gravity="center"
        android:text="🥬"
        android:textSize="25sp"
        android:background="@drawable/bg_chip"
        android:layout_marginRight="14dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textIngredientName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="우유"
                android:textColor="@color/text_main"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textFavorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐"
                android:textSize="15sp"
                android:layout_marginLeft="6dp"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/textIngredientCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="유제품"
            android:textColor="@color/text_sub"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/textExpireDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="D-3"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="@color/accent_orange"
            android:background="@drawable/bg_chip_white"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/textIngredientPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30%"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/primary_green_dark"
            android:background="@drawable/bg_chip"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/btnFavorite"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="☆"
            android:textSize="24sp"
            android:textColor="@color/accent_coral"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/btnDeleteIngredient"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:gravity="center"
        android:text="×"
        android:textSize="23sp"
        android:textStyle="bold"
        android:textColor="@color/text_hint"
        android:layout_marginLeft="6dp" />

</LinearLayout>