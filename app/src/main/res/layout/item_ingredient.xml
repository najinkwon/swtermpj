<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootIngredientItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="86dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_ingredient_item"
    android:paddingLeft="16dp"
    android:paddingRight="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:elevation="0dp"
    android:layout_marginLeft="1dp"
    android:layout_marginRight="1dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/textIngredientSelect"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:gravity="center"
        android:text="✓"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/bg_primary_button"
        android:layout_marginRight="8dp"
        android:visibility="gone"
        android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/textIngredientIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="🥬"
        android:textSize="31sp"
        android:layout_marginRight="14dp"
        android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingRight="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textIngredientName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="우유"
                android:textColor="@color/text_main"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/textFavorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★"
                android:textSize="13sp"
                android:textColor="@color/accent_coral"
                android:layout_marginLeft="5dp"
                android:visibility="gone"
                android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/textIngredientCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="유제품"
            android:textColor="@color/text_sub"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/textExpireDay"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="D-3"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="@color/accent_orange"
                android:background="@drawable/bg_expire_pill"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/textIngredientPercent"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="부족"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/primary_green_dark"
                android:background="@drawable/bg_stock_pill"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_marginLeft="6dp"
                android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/btnFavorite"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="☆"
            android:textSize="21sp"
            android:textColor="@color/text_hint"
            android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/btnDeleteIngredient"
            android:layout_width="32dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="×"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/text_hint"
            android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

    </LinearLayout>

</LinearLayout>
