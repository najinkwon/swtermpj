<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="110dp">

        <TextView
            android:id="@+id/textRecipeImageEmoji"
            android:layout_width="match_parent"
            android:layout_height="154dp"
            android:gravity="center"
            android:text="🍳"
            android:textSize="64sp"
            android:background="@drawable/bg_recipe_hero"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/textRecipeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="계란볶음밥"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/text_main"
            android:layout_marginTop="20dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/textRecipeReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="냉장고 재료 기준으로 만들 수 있는 메뉴예요"
            android:textSize="14sp"
            android:textColor="@color/text_sub"
            android:layout_marginTop="10dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="18dp">

            <TextView
                android:id="@+id/textMatch"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="재료 90%"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_match_chip"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/textCookTime"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="10분"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:background="@drawable/bg_chip_white"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:layout_marginLeft="8dp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/textDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="쉬움"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:background="@drawable/bg_chip_white"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:layout_marginLeft="8dp"
                android:includeFontPadding="false" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutIngredientCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:elevation="0dp"
            android:layout_marginTop="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="필요한 재료"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/textIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• 계란 1개 필요"
                android:textSize="15sp"
                android:textColor="@color/text_main"
                android:lineSpacingExtra="8dp"
                android:layout_marginTop="15dp"
                android:includeFontPadding="false" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:elevation="0dp"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="조리 순서"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/textSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. 재료를 준비해요"
                android:textSize="15sp"
                android:textColor="@color/text_main"
                android:lineSpacingExtra="7dp"
                android:layout_marginTop="16dp"
                android:includeFontPadding="false" />

        </LinearLayout>

        <Button
            android:id="@+id/btnYoutube"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="유튜브 레시피 보기"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_youtube_button"
            android:backgroundTint="@null"
            android:textColor="@color/white"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:layout_marginTop="18dp" />

        <Button
            android:id="@+id/btnShopping"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="부족 재료 장보기"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:textColor="@color/white"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnCookDone"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="요리했어요"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_white"
            android:backgroundTint="@null"
            android:textColor="@color/primary_green_dark"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</ScrollView>
