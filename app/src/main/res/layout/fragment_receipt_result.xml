<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="인식 결과"
                    android:textColor="@color/text_main"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="영수증에서 찾은 재료를 확인하세요"
                    android:textColor="@color/text_sub"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <TextView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="✅"
                android:textSize="24sp"
                android:background="@drawable/bg_chip" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_stat_mint"
            android:padding="18dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/textReceiptResultSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="총 0개의 재료를 찾았어요"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="확인 후 냉장고에 한 번에 추가할 수 있어요"
                android:textColor="@color/text_sub"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnAddReceiptCandidate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="인식 후보 직접 추가"
            android:textSize="15sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/layoutReceiptItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnAddReceiptItems"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="선택한 재료 냉장고에 추가"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>
