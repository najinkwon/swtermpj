<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="108dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingRight="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="인식 결과"
                    android:textColor="@color/text_main"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="찾은 재료를 확인하고 냉장고에 추가해요"
                    android:textColor="@color/text_sub"
                    android:textSize="14sp"
                    android:layout_marginTop="7dp"
                    android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

            </LinearLayout>

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="✓"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/primary_green_dark"
                android:background="@drawable/bg_chip"
                android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:layout_marginBottom="16dp"
            android:elevation="0dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

            <TextView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:gravity="center"
                android:text="🧾"
                android:textSize="25sp"
                android:layout_marginRight="14dp"
                android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textReceiptResultSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="총 0개의 재료 후보를 확인했어요"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:textSize="19sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="확인 후 한 번에 냉장고에 저장해요"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="8dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:includeFontPadding="true" />

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnAddReceiptCandidate"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="후보 직접 추가"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary_green_dark"
            android:background="@drawable/bg_chip_white"
            android:backgroundTint="@null"
            android:gravity="center"
            android:includeFontPadding="true"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:layout_marginBottom="14dp"
        
        android:stateListAnimator="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="재료 후보"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

        <LinearLayout
            android:id="@+id/layoutReceiptItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnAddReceiptItems"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="선택한 재료 냉장고에 추가"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:gravity="center"
            android:includeFontPadding="true"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:layout_marginTop="10dp"
        
        android:stateListAnimator="@null" />

    </LinearLayout>

</ScrollView>
