<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="20dp"
    android:background="@color/app_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingRight="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="알림"
                android:textColor="@color/text_main"
                android:textSize="30sp"
                android:textStyle="bold"
                android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/textNotificationSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="냉장고 상태를 확인해요"
                android:textColor="@color/text_sub"
                android:textSize="14sp"
                android:layout_marginTop="7dp"
                android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

        </LinearLayout>

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/primary_green_dark"
            android:background="@drawable/bg_chip"
            android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="0dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="놓치기 쉬운 재료 상태를 알려드려요"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="재고 부족과 유통기한 임박 알림을 한곳에서 확인할 수 있어요"
            android:textColor="@color/text_sub"
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:includeFontPadding="true" />

        <LinearLayout
            android:id="@+id/layoutNotificationActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <Button
                android:id="@+id/btnMarkAllRead"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="모두 읽음"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary_green_dark"
                android:background="@drawable/bg_chip_white"
                android:backgroundTint="@null"
                android:gravity="center"
                android:includeFontPadding="true"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
        
        android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnResetDeletedNotifications"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="삭제 초기화"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/accent_red"
                android:background="@drawable/bg_soft_red_chip"
                android:backgroundTint="@null"
                android:layout_marginLeft="8dp"
                android:gravity="center"
                android:includeFontPadding="true"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
        
        android:stateListAnimator="@null" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="최근 알림"
        android:textColor="@color/text_main"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"
        android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerNotification"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="82dp" />

</LinearLayout>
