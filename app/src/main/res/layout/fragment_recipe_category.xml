<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="레시피"
                    android:textColor="@color/text_main"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="오늘 먹고 싶은 메뉴를 골라보세요"
                    android:textColor="@color/text_sub"
                    android:textSize="14sp"
                    android:layout_marginTop="7dp"
                    android:includeFontPadding="false" />

            </LinearLayout>

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="🍳"
                android:textSize="22sp"
                android:background="@drawable/bg_chip"
                android:includeFontPadding="false" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:layout_marginBottom="20dp"
            android:elevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="냉장고 재료로 추천받기"
                android:textColor="@color/text_main"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="보유한 재료를 기준으로 냉털 메뉴를 만들어드려요"
                android:textColor="@color/text_sub"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="8dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <Button
                android:id="@+id/btnAiRecommend"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="추천받기"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_primary_button"
                android:backgroundTint="@null"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:layout_marginTop="16dp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="카테고리로 보기"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardKorean"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="@drawable/bg_stat_mint"
                android:clickable="true"
                android:focusable="true"
                android:elevation="0dp"
                android:layout_marginRight="7dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="🍚"
                    android:textSize="25sp"
                    android:background="@drawable/bg_chip_white"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="한식"
                    android:textColor="@color/text_main"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="든든한 집밥 메뉴"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    android:layout_marginTop="7dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardWestern"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="@drawable/bg_stat_peach"
                android:clickable="true"
                android:focusable="true"
                android:elevation="0dp"
                android:layout_marginLeft="7dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="🍝"
                    android:textSize="25sp"
                    android:background="@drawable/bg_chip_white"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="양식"
                    android:textColor="@color/text_main"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="가벼운 브런치 메뉴"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    android:layout_marginTop="7dp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/cardJapanese"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="0dp"
                android:layout_marginRight="7dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="🍱"
                    android:textSize="25sp"
                    android:background="@drawable/bg_chip"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="일식"
                    android:textColor="@color/text_main"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="깔끔한 한 끼 메뉴"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    android:layout_marginTop="7dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardEtc"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="@drawable/bg_stat_yellow"
                android:clickable="true"
                android:focusable="true"
                android:elevation="0dp"
                android:layout_marginLeft="7dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="🥗"
                    android:textSize="25sp"
                    android:background="@drawable/bg_chip_white"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="기타"
                    android:textColor="@color/text_main"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="간식부터 샐러드까지"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    android:layout_marginTop="7dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
