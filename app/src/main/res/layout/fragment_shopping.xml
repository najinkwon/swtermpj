<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="20dp"
    android:background="@color/app_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingRight="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="장보기"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/textShoppingSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="지금 필요한 재료를 모았어요"
                android:textSize="14sp"
                android:textColor="@color/text_sub"
                android:layout_marginTop="7dp"
                android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

        </LinearLayout>

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="🛒"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/primary_green_dark"
            android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/shoppingSummaryCard"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:layout_marginBottom="18dp"
        android:elevation="0dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:gravity="center"
            android:text="🧺"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/primary_green_dark"
            android:layout_marginRight="14dp"
            android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textShoppingMainMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="필요한 재료만 담았어요"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:maxLines="2"
                android:ellipsize="end"
                android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/textShoppingSubMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="부족한 재료를 빠르게 확인하고 검색해요"
                android:textSize="13sp"
                android:textColor="@color/text_sub"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="8dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:includeFontPadding="true" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="구매 목록"
        android:textColor="@color/text_main"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"
        android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerShopping"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="82dp" />

        <LinearLayout
            android:id="@+id/layoutShoppingEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:paddingTop="34dp"
            android:paddingBottom="34dp"
            android:visibility="gone"
            android:elevation="0dp">

            <TextView
                android:id="@+id/textShoppingEmptyIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:gravity="center"
                android:text="✓"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/primary_green_dark"
                android:background="@drawable/bg_chip"
                android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/textShoppingEmptyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="구매할 재료가 없어요"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textSize="21sp"
                android:gravity="center"
                android:layout_marginTop="18dp"
                android:includeFontPadding="true"
        
        android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/textShoppingEmptyMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="재고가 충분해요. 부족해지면 여기에서 알려드릴게요."
                android:textColor="@color/text_sub"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="10dp"
                android:includeFontPadding="true" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
