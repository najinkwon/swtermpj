<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="24dp"
        android:paddingBottom="108dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingRight="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="냉털매니저"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:letterSpacing="-0.03"
                    android:includeFontPadding="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="남은 재료로 오늘의 메뉴를 골라요"
                    android:textSize="14sp"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="4dp"
                    android:includeFontPadding="true" />

            </LinearLayout>

            <TextView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="🥬"
                android:textSize="30sp"
                android:includeFontPadding="true" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="112dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_home_hero_vibe"
            android:paddingLeft="22dp"
            android:paddingRight="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:layout_marginTop="22dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingRight="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="오늘 냉장고 상태"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:letterSpacing="-0.02"
                    android:includeFontPadding="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="부족 재료와 임박 재료를 확인해보세요"
                    android:textSize="14sp"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="6dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:lineSpacingExtra="3dp"
                    android:includeFontPadding="true" />

            </LinearLayout>

            <TextView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:gravity="center"
                android:text="🥗"
                android:textSize="38sp"
                android:includeFontPadding="true" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:id="@+id/cardTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="86dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingLeft="18dp"
                android:paddingRight="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@drawable/bg_home_green_card"
                android:layout_marginRight="6dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="0dp">

                <TextView
                    android:id="@+id/textTotalCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:includeFontPadding="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="총 재료"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:includeFontPadding="true" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardFavorite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="86dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingLeft="18dp"
                android:paddingRight="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@drawable/bg_home_peach_card"
                android:layout_marginLeft="6dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="0dp">

                <TextView
                    android:id="@+id/textFavoriteCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_coral"
                    android:includeFontPadding="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="즐겨찾기"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:includeFontPadding="true" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/cardLowStock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="86dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingLeft="18dp"
                android:paddingRight="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@drawable/bg_home_red_card"
                android:layout_marginRight="6dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="0dp">

                <TextView
                    android:id="@+id/textLowStockCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_red"
                    android:includeFontPadding="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="부족"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:includeFontPadding="true" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardExpire"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="86dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingLeft="18dp"
                android:paddingRight="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@drawable/bg_home_yellow_card"
                android:layout_marginLeft="6dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="0dp">

                <TextView
                    android:id="@+id/textExpireCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_orange"
                    android:includeFontPadding="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="임박"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:includeFontPadding="true" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="오늘의 추천"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:letterSpacing="-0.03"
                android:includeFontPadding="true" />

            <TextView
                android:id="@+id/buttonMoreRecipe"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="전체보기"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary_green_dark"
                android:background="@drawable/bg_soft_green_pill"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:includeFontPadding="true" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerRecipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false" />

    </LinearLayout>

</ScrollView>
