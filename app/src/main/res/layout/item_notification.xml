<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notificationRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="14dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:elevation="0dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/textNotificationIcon"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="⚠️"
        android:textSize="23sp"
        android:background="@drawable/bg_chip"
        android:layout_marginRight="13dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textNotificationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="우유 유통기한 임박"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/textNotificationMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="D-2 남았어요"
            android:textColor="@color/text_sub"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/textNotificationTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="방금 전"
            android:textColor="@color/primary_green_dark"
            android:textStyle="bold"
            android:textSize="12sp"
            android:background="@drawable/bg_chip"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/btnDeleteNotification"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:gravity="center"
        android:text="×"
        android:textColor="@color/text_hint"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginLeft="8dp" />

</LinearLayout>