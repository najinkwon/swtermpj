<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="OutlineButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_outline_button</item>
        <item name="android:textColor">@color/primary_green_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="DangerButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_danger_button</item>
        <item name="android:textColor">@color/accent_red</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- 기존 파일 호환용. 나중에 안 쓰면 삭제 가능 -->
    <style name="PinkButton" parent="PrimaryButton" />

</resources>